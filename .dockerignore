# Ignore Git and CI/CD metadata
.git
.gitignore

.github
README.md
# Ignore node modules and build artifacts
node_modules
npm-debug.log
yarn-error.log

# Ignore Composer cache and vendor (we rebuild vendor in php-deps stage)
vendor/

# Ignore frontend build cache
public/frontend/node_modules
public/frontend/.cache
public/frontend/dist

# Ignore OS/editor junk
.DS_Store
Thumbs.db
*.swp

# Ignore environment files (never bake secrets into images)
.env
.env.local
.env.*.backup

# Ignore logs
*.log
logs/
*.log.*
debug.log
error.log
access.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
php-error.log
storage/logs/
*.log
